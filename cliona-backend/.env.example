# Database — [A3] a real Postgres DSN, NOT derived from SUPABASE_URL
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter
OPENROUTER_API_KEY=
LLM_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free

# Clerk
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=https://clerk.your-domain.com
CLERK_JWKS_URL=

# Server
ENVIRONMENT=development
LOG_LEVEL=INFO
